/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://cdn.bsky.app data:; font-src https://static.joseli.to; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/oauth/*
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=600

/assets/*
  Cache-Control: public, max-age=31536000, immutable
