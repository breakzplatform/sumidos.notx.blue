{
  "name": "sumidos.notx.blue",
  "version": "0.1.0",
  "private": true,
  "description": "Find out who a Bluesky account follows that stopped posting, and unfollow them from your own list.",
  "license": "GPL-3.0-only",
  "author": "Joselito <eu@joseli.to>",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
