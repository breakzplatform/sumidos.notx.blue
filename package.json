  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
